# ACLED API credentials — register free at https://acleddata.com/register/
# NOTE: ACLED moved to OAuth2 access tokens in 2024. If you have an older
# key+email pair the classic "read" endpoint may still work; otherwise set
# ACLED_OAUTH_TOKEN and the ingester will send it as a Bearer token.
ACLED_API_KEY=
ACLED_EMAIL=
ACLED_OAUTH_TOKEN=

# GDELT needs no key.

# Anthropic API key for the LLM-based framing judge (src/analysis/framing_llm.py).
# Get one at https://console.anthropic.com/. The SDK reads this automatically.
ANTHROPIC_API_KEY=
